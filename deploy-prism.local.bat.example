@echo off
rem Copy this file to deploy-prism.local.bat (gitignored - it's machine-specific) and fill in your own paths.
rem test-addon-prism.bat loads this automatically.

rem The instance ID: the name of its folder under PrismLauncher\instances\
rem (right-click the instance in PrismLauncher -> Instance Folder to confirm).
set PRISM_INSTANCE=...

rem Full path to the PrismLauncher instance's mods folder.
set MODS_DIR=C:\Users\...\AppData\Roaming\PrismLauncher\instances\%PRISM_INSTANCE%\.minecraft\mods

rem Full path to prismlauncher.exe. Leave blank to skip auto-launch and only build+deploy.
set PRISM_EXE=C:\Users\...\AppData\Local\Programs\PrismLauncher\prismlauncher.exe
