{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${display_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "${mod_repo}",
    "issues": "${mod_repo}/issues"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "${mod_package}.Addon"
    ]
  },
  "mixins": [
  ],
  "custom": {
    "meteor-client:color": "${mod_color}",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_depends}",
    "meteor-client": "*"
  }
}
